    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary consultation action; base desktop variant.",
      "html": "<button class=\"ds-button ds-primary\" type=\"button\">Quiero una consulta<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:28px;min-height:54px;padding:14px 23px;border-radius:5px;font-family:var(--display,Manrope,sans-serif);font-size:14px;font-weight:600;line-height:1.4;border:1px solid var(--green,#174a43);text-decoration:none;white-space:nowrap;cursor:pointer;transition:background .25s,color .25s,transform .25s}.ds-button svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.ds-button:active{transform:translateY(2px)}.ds-button:focus-visible{outline:3px solid var(--focus,#729854);outline-offset:5px}.ds-primary{background:var(--green,#174a43);color:var(--white,#fffef9)}.ds-primary:hover{background:var(--green-dark,#143c36);color:var(--paper,#f6f5f0)}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Outline button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary action; header uses compact sizing.",
      "html": "<button class=\"ds-button ds-outline\" type=\"button\">Reservar un turno<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:28px;min-height:54px;padding:14px 23px;border-radius:5px;font-family:var(--display,Manrope,sans-serif);font-size:14px;font-weight:600;line-height:1.4;border:1px solid var(--green,#174a43);text-decoration:none;white-space:nowrap;cursor:pointer;transition:background .25s,color .25s,transform .25s}.ds-button svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.ds-button:active{transform:translateY(2px)}.ds-button:focus-visible{outline:3px solid var(--focus,#729854);outline-offset:5px}.ds-outline{background:transparent;color:var(--ink,#183f39)}.ds-outline:hover{background:var(--green,#174a43);color:var(--paper,#f6f5f0)}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Text link",
      "kind": "button",
      "refersTo": "text-link",
      "description": "Underlined hover with a gently shifting inline arrow.",
      "html": "<a class=\"ds-link\" href=\"#tratamientos\">Conocé los tratamientos<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></a>",
      "css": ".ds-link{display:inline-flex;align-items:center;gap:17px;font:600 14px/1.5 var(--display,Manrope,sans-serif);color:var(--ink,#183f39);text-decoration:none}.ds-link svg{width:18px;height:24px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;transition:transform .3s var(--ease,cubic-bezier(.16,1,.3,1))}.ds-link:hover{text-decoration:underline}.ds-link:hover svg{transform:translate(3px,-3px)}.ds-link:focus-visible{outline:3px solid var(--focus,#729854);outline-offset:5px}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Contact field",
      "kind": "input",
      "refersTo": "field",
      "description": "Bottom-rule field; visible label and native validation.",
      "html": "<div class=\"ds-field\"><label for=\"ds-name\">¿Cómo te llamás?</label><input id=\"ds-name\" name=\"nombre\" placeholder=\"Tu nombre y apellido\" autocomplete=\"name\" maxlength=\"100\" required></div>",
      "css": ".ds-field{margin-bottom:23px;color:var(--ink,#183f39)}.ds-field label{display:block;font:600 11px var(--display,Manrope,sans-serif);margin-bottom:7px}.ds-field input{display:block;width:100%;border:0;border-bottom:1px solid var(--field-line,#94a88f);background:transparent;color:var(--ink,#183f39);border-radius:0;padding:9px 0 13px;font:400 14px/1.6 var(--body,\"DM Sans\",sans-serif);caret-color:var(--green,#174a43)}.ds-field input::placeholder{color:var(--placeholder,#596a5b);opacity:1}.ds-field input:focus-visible{outline:2px solid var(--focus,#729854);outline-offset:3px}@media(max-width:600px){.ds-field input{font-size:16px}}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Desktop navigation links; mobile dropdown behavior is documented in DESIGN.md.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navegación principal\"><a href=\"#tratamientos\">Tratamientos</a><a href=\"#filosofia\">Nuestra mirada</a><a href=\"#contacto\">Encontranos</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:30px;color:var(--ink,#183f39);font:600 13px var(--display,Manrope,sans-serif)}.ds-nav a{position:relative;color:inherit;text-decoration:none}.ds-nav a:after{content:\"\";position:absolute;bottom:-7px;height:1px;background:var(--green,#174a43);left:0;width:100%;transform:scaleX(0);transform-origin:left;transition:transform .3s}.ds-nav a:hover:after{transform:scaleX(1)}.ds-nav a:focus-visible{outline:3px solid var(--focus,#729854);outline-offset:5px}@media(max-width:800px){.ds-nav{background:var(--paper,#f6f5f0);padding:25px 24px 32px;border-bottom:1px solid var(--line,#d8ddd2);flex-direction:column;align-items:flex-start;gap:20px;font-size:16px}}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Treatment disclosure",
      "kind": "custom",
      "refersTo": "treatment-disclosure",
      "description": "Native treatment row; toggle preserves browser keyboard semantics.",
      "html": "<details class=\"ds-treatment\"><summary><span>Odontología integral<small>El cuidado de todos los días</small></span><span class=\"ds-expand\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\"/></svg></span></summary><p>Controles, prevención y limpieza dental. Una evaluación integral para cuidar tu salud bucal.</p></details>",
      "css": ".ds-treatment{border-block:1px solid var(--line,#d8ddd2);color:var(--ink,#183f39)}.ds-treatment summary{cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:27px 0;font:600 23px/1.4 var(--display,Manrope,sans-serif);letter-spacing:-.025em}.ds-treatment summary::-webkit-details-marker{display:none}.ds-treatment small{display:block;font:400 12px var(--body,\"DM Sans\",sans-serif);color:var(--muted,#526158);letter-spacing:0;margin-top:5px}.ds-expand{display:grid;place-items:center;width:32px;height:32px;border:1px solid var(--line,#d8ddd2);border-radius:50%;flex-shrink:0;transition:background .25s,color .25s}.ds-expand svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;transition:transform .3s var(--ease,cubic-bezier(.16,1,.3,1))}.ds-treatment[open] .ds-expand{background:var(--green,#174a43);border-color:var(--green,#174a43);color:var(--paper,#f6f5f0)}.ds-treatment[open] svg{transform:rotate(45deg)}.ds-treatment p{padding:0 48px 25px 0;color:var(--muted,#526158);font:400 14px/1.8 var(--body,\"DM Sans\",sans-serif);max-width:490px;margin:0}.ds-treatment summary:focus-visible{outline:3px solid var(--focus,#729854);outline-offset:5px}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Sage treatment aside",
      "kind": "card",
      "refersTo": "treatment-aside",
      "description": "Flat supportive panel with a partial circle and contrasting italic emphasis.",
      "html": "<aside class=\"ds-aside\"><p>No se trata solo<br>de tus dientes.<br><em>Se trata de vos.</em></p><a class=\"ds-aside-link\" href=\"#contacto\">Hablemos de tu sonrisa<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></a></aside>",
      "css": ".ds-aside{background:var(--sage,#dde4d6);color:var(--ink,#183f39);padding:38px 43px;border-radius:4px;min-height:430px;position:relative;overflow:hidden;display:flex;flex-direction:column;align-items:flex-start;justify-content:space-between}.ds-aside:after{content:\"\";position:absolute;width:360px;height:360px;border:1px solid var(--sage-outline,#b7c6b1);border-radius:50%;right:-240px;top:115px;pointer-events:none}.ds-aside p{font:600 33px/1.4 var(--display,Manrope,sans-serif);letter-spacing:-.035em;margin:30px 0 45px}.ds-aside em{font:italic 500 36px/1.5 var(--serif,Playfair,Georgia,serif)}.ds-aside-link{display:inline-flex;gap:17px;align-items:center;color:inherit;font:600 13px/1.5 var(--display,Manrope,sans-serif);text-decoration:none}.ds-aside-link svg{width:18px;height:24px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;transition:transform .3s var(--ease,cubic-bezier(.16,1,.3,1))}.ds-aside-link:hover{text-decoration:underline}.ds-aside-link:hover svg{transform:translate(3px,-3px)}.ds-aside-link:focus-visible{outline:3px solid var(--focus,#729854);outline-offset:5px}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Portrait note",
      "kind": "custom",
      "refersTo": "portrait-note",
      "description": "Overlapping image annotation; the system’s only shadow.",
      "html": "<div class=\"ds-note\"><span class=\"ds-note-icon\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\"/></svg></span><span>Precisión clínica.<br><strong>Calidez humana.</strong></span></div>",
      "css": ".ds-note{display:inline-flex;align-items:center;gap:15px;background:var(--white,#fffef9);color:var(--ink,#183f39);padding:18px 30px 18px 18px;font:400 13px/1.7 var(--display,Manrope,sans-serif);border-radius:3px;box-shadow:0 14px 30px rgba(19,55,39,.09)}.ds-note strong{font-weight:600}.ds-note-icon{width:41px;height:41px;display:grid;place-items:center;background:var(--sage,#dde4d6);border-radius:50%}.ds-note-icon svg{width:23px;height:24px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}"
    },
    {
      "name": "Smile seal",
